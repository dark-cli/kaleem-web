---
// Working theme toggle button with sun/moon icons
---

<button id="theme-toggle-btn" aria-label="Toggle dark mode" title="Toggle dark mode" class="theme-toggle-btn">
  <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5"/>
    <line x1="12" y1="1" x2="12" y2="3"/>
    <line x1="12" y1="21" x2="12" y2="23"/>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
    <line x1="1" y1="12" x2="3" y2="12"/>
    <line x1="21" y1="12" x2="23" y2="12"/>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
  </svg>
  <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 1 0 9.79 9.79z"/>
  </svg>
</button>

<style>
.theme-toggle-btn {
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.2em;
  height: 2.2em;
  color: var(--accent);
  transition: color 0.2s ease-in-out;
}

.theme-toggle-btn:hover {
  color: var(--accent-dark);
}

.sun-icon,
.moon-icon {
  width: 1em;
  height: 1em;
  display: none;
}

/* Light mode: show moon icon (click to switch to dark) */
html:not([data-theme="dark"]) .moon-icon {
  display: block;
}

/* Dark mode: show sun icon (click to switch to light) */
html[data-theme="dark"] .sun-icon {
  display: block;
}
</style>
